{
  "expo": {
    "name": "m\u00f8ma",
    "slug": "moma",
    "version": "1.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moma",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.joinmoma.moma",
      "buildNumber": "43",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:joinmoma.org"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "fr",
          "es"
        ],
        "NSPhotoLibraryUsageDescription": "m\u00f8ma needs your photos so you can add a picture to your profile and to what you bring to the table.",
        "NSCameraUsageDescription": "m\u00f8ma uses your camera so you can take a picture for your profile or for what you bring to the table.",
        "NSMicrophoneUsageDescription": "m\u00f8ma does not record audio. This permission is only requested by a component we use for video previews.",
        "NSFaceIDUsageDescription": "m\u00f8ma uses Face ID to keep you signed in without retyping your password.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "m\u00f8ma uses your location to match you with moms in your neighbourhood.",
        "NSLocationAlwaysUsageDescription": "m\u00f8ma uses your location to match you with moms in your neighbourhood.",
        "NSRemindersUsageDescription": "m\u00f8ma can add your group meetups to your reminders so you do not miss them.",
        "NSRemindersFullAccessUsageDescription": "m\u00f8ma can add your group meetups to your reminders so you do not miss them."
      }
    },
    "android": {
      "package": "org.joinmoma.moma",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "joinmoma.org",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "joinmoma.org",
              "pathPrefix": "/group-preview"
            },
            {
              "scheme": "https",
              "host": "joinmoma.org",
              "pathPrefix": "/learn"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBOIdjfvQdpOM2qbaS6GqrYREInX4Y-Lzg"
        }
      },
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "m\u00f8ma uses your location to match you with moms in your neighbourhood."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "m\u00f8ma adds your group meetups to your calendar so you don't miss them."
        }
      ],
      "expo-asset",
      "expo-localization",
      "./plugins/withLocalizedPermissions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4659e472-4454-4e9a-8de6-915cd70a2bb6"
      }
    },
    "owner": "superbhaal"
  }
}
